# =============================================================
# BDD Soluções Financeiras — .env de PRODUÇÃO
# Copie este arquivo para ".env" no servidor e preencha os valores.
# NUNCA commitar este arquivo com valores reais.
# =============================================================

# ===== Servidor =====
PORT=8080
NODE_ENV=production
# Em produção SEMPRE deixe false (ativa redirect https + HSTS).
# Deixe true SOMENTE se o host não fornecer SSL.
DISABLE_HTTPS_REDIRECT=false

# ===== Banco de dados MySQL (hPanel: Databases) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=TROQUE_pelo_usuario_do_hpanel
# Senha forte (mín. 16 chars, misto). Ex: g4Lh!qZ9wR#2sB7xN
DB_PASSWORD=TROQUE_POR_SENHA_FORTE_16MAIS
DB_NAME=TROQUE_pelo_nome_do_banco_hpanel

# ===== Autenticação JWT (obrigatório: forte e aleatório) =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=TROQUE_POR_SEGREDO_ALEATORIO_32_MAIS_CARACTERES
JWT_EXPIRES_IN=7d

# ===== Conta admin (criada pelo seeder NO PRIMEIRO BOOT) =====
# Se deixar vazio, o admin NÃO é criado.
ADMIN_EMAIL=seu-email-admin@dominio.com
ADMIN_PASSWORD=TROQUE_POR_SENHA_FORTE_DO_ADMIN

# ===== Push notifications (VAPID) — gere as chaves =====
# npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:seu-email@dominio.com
VAPID_PUBLIC_KEY=TROQUE_PELA_CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=TROQUE_PELA_CHAVE_PRIVADA_VAPID

# ===== E-mail SMTP (Brevo) — recuperação de senha, confirmação, convites =====
# SMTP_USER = campo "Fazer login" do Brevo (NÃO é o e-mail da conta)
# SMTP_FROM = use o MESMO SMTP_USER (sender sempre aceito)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=TROQUE_pelo_login_smtp_brevo@smtp-brevo.com
SMTP_PASS=TROQUE_pela_chave_smtp_xsmtpsib
SMTP_FROM=TROQUE_pelo_login_smtp_brevo@smtp-brevo.com
SMTP_SECURE=false

# ===== PIX (chave de recebimento do plano Pro) =====
PIX_EMAIL=seu-pix@email.com
PIX_COPIA_E_COLA=TROQUE_pelo_copia_e_cola_pix

# ===== Google Login (opcional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Frontend =====
CLIENT_DIST=../client/dist

# =============================================================
# ANTES DE SUBIR: confira o DEPLOY-CHECKLIST.md (seção 2 e 8).
# =============================================================