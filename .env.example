# ===== Configurações do servidor =====
PORT=8080
NODE_ENV=production

# ===== Banco de dados MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=bdd
DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DB_NAME=bdd

# ===== Autenticação JWT =====
JWT_SECRET=TROQUE_POR_UM_SEGREDO_LONGO_E_FORTE
JWT_EXPIRES_IN=7d

# ===== Conta admin (criada pelo seeder) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Push notifications (VAPID - opcional) =====
VAPID_SUBJECT=mailto:contato@seudominio.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== E-mail SMTP (Brevo) - para recuperação de senha, confirmação de cadastro e convites =====
# SMTP_USER = campo "Fazer login" do painel Brevo (ex: b91adf001@smtp-brevo.com)
# SMTP_PASS = chave SMTP do Brevo (formato xsmtpsib-...)
# SMTP_FROM = use o mesmo SMTP_USER (sender sempre aceito; remetente não verificado é rejeitado)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# ===== PIX (chave de recebimento do plano Pro) =====
PIX_EMAIL=seu-pix@email.com
PIX_COPIA_E_COLA=

# ===== Google Login (opcional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Frontend =====
CLIENT_DIST=../client/dist
DISABLE_HTTPS_REDIRECT=false